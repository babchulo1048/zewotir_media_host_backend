# ------------------------------------------------------------
# 🌐 Node.js
# ------------------------------------------------------------

# Dependencies
/node_modules
/jspm_packages

# Lock Files (keep if your team relies on a specific version)
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# Testing and Coverage
/coverage
/.nyc_output
/testem.json

# Logs and Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
/pids
/logs
/results

# ------------------------------------------------------------
# 🔒 Environment Variables and Secrets
# ------------------------------------------------------------
# Never commit sensitive credentials or API keys
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# 🧠 IDE and Editor
# ------------------------------------------------------------
# VS Code and JetBrains IDEs
.vscode/
.idea/

# Temporary or Backup Files
*.swp
*.bak
*~
/thumbs.db
.DS_Store

# ------------------------------------------------------------
# ⚙️ Build Artifacts
# ------------------------------------------------------------
# Output folders from build tools (Webpack, Babel, TypeScript, etc.)
/dist
/build
/out
/tmp
/temp
/public/build

# ------------------------------------------------------------
# 🧩 TypeScript
# ------------------------------------------------------------
# Exclude compiled JavaScript and metadata from TypeScript
*.tsbuildinfo

# ------------------------------------------------------------
# ✅ Optional Extras
# ------------------------------------------------------------
# If using Next.js or similar frameworks
.next/
.vercel/

# If using Docker
Dockerfile
docker-compose.yml
.dockerignore

# If using Prisma ORM
/prisma/dev.db
/prisma/migrations/
